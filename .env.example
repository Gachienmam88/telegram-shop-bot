# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.

# ===== Telegram =====
# Token lấy từ @BotFather
BOT_TOKEN=
# Username bot, KHÔNG có @ (dùng cho deep link t.me/<username>?start=...)
BOT_USERNAME=
# Telegram user id của admin, nhiều người cách nhau dấu phẩy (lấy id qua @userinfobot)
ADMIN_IDS=
# Username admin hỗ trợ khách, không có @
SUPPORT_USERNAME=
# Group/channel nhận thông báo hàng về: id dạng -100xxxxxxxxxx hoặc @ten_channel (bot phải là admin ở đó). Bỏ trống = không gửi group
NOTIFY_CHAT_ID=
SHOP_NAME=AI SHOP

# ===== Ngân hàng nhận tiền (VietQR) =====
# Mã ngân hàng theo VietQR, vd MB, VCB, TCB, ACB...
BANK_CODE=MB
BANK_DISPLAY_NAME=MB Bank
BANK_ACCOUNT_NUMBER=
# Tên chủ tài khoản, IN HOA không dấu
BANK_ACCOUNT_NAME=

# ===== SePay =====
# API Key đặt ở SePay → Webhooks → Kiểu chứng thực "API Key"
SEPAY_API_KEY=

# ===== Thanh toán =====
ORDER_TIMEOUT_SECONDS=300
TOPUP_MIN=10000
TOPUP_MAX=50000000
# 1 USDT = ? VND (quy đổi giá khi thanh toán USDT + hiển thị trong thông báo hàng về)
USDT_RATE=27000

# ===== Thanh toán USDT (để trống địa chỉ = tắt mạng đó) =====
# Chỉ cần ĐỊA CHỈ ví nhận, KHÔNG BAO GIỜ điền private key / seed phrase.
CRYPTO_BSC_ADDRESS=
CRYPTO_TRON_ADDRESS=
CRYPTO_POLYGON_ADDRESS=
# Thời gian giữ đơn / lệnh nạp chờ chuyển USDT (giây)
CRYPTO_TIMEOUT_SECONDS=1800
# Tùy chọn: node RPC riêng (mặc định dùng publicnode miễn phí) và API key TronGrid (tăng giới hạn gọi)
# CRYPTO_BSC_RPC=https://bsc-rpc.publicnode.com
# CRYPTO_POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# TRONGRID_API_KEY=

# ===== Database =====
# Chạy local (mvn spring-boot:run): giữ mặc định nếu dùng docker-compose.yml
DB_URL=jdbc:postgresql://localhost:5432/shopbot
DB_NAME=shopbot
DB_USER=shopbot
DB_PASSWORD=shopbot

# ===== Cloudflare Tunnel (chỉ production) =====
CF_TUNNEL_TOKEN=
